@model DocumentSearchViewModel

@{
    ViewData["Title"] = "Documents";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Documents</h1>
    <a asp-action="Create" class="btn btn-primary">Create Document</a>
</div>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-8 col-lg-6">
        <label asp-for="SearchTerm" class="form-label">Search</label>
        <input asp-for="SearchTerm" class="form-control" placeholder="Title, number, department, owner, or status" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (Model.Documents.Count == 0)
{
    <div class="alert alert-info">No documents were found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Document Number</th>
                    <th>Department</th>
                    <th>Owner</th>
                    <th>Status</th>
                    <th>Updated</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var document in Model.Documents)
            {
                <tr>
                    <td>@document.Title</td>
                    <td>@document.DocumentNumber</td>
                    <td>@document.Department</td>
                    <td>@document.OwnerName</td>
                    <td><span class="badge text-bg-secondary">@document.Status</span></td>
                    <td>@document.UpdatedAtUtc.ToString("u")</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@document.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Edit" asp-route-id="@document.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@document.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
