@model DocumentDetailsViewModel

@{
    ViewData["Title"] = "Document Details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Document Details</h1>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Id</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Document Number</dt>
    <dd class="col-sm-9">@Model.DocumentNumber</dd>

    <dt class="col-sm-3">Department</dt>
    <dd class="col-sm-9">@Model.Department</dd>

    <dt class="col-sm-3">Owner Name</dt>
    <dd class="col-sm-9">@Model.OwnerName</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "None" : Model.Description)</dd>

    <dt class="col-sm-3">Created At UTC</dt>
    <dd class="col-sm-9">@Model.CreatedAtUtc.ToString("u")</dd>

    <dt class="col-sm-3">Updated At UTC</dt>
    <dd class="col-sm-9">@Model.UpdatedAtUtc.ToString("u")</dd>

    <dt class="col-sm-3">Deleted At UTC</dt>
    <dd class="col-sm-9">@(Model.DeletedAtUtc?.ToString("u") ?? "Not deleted")</dd>
</dl>
