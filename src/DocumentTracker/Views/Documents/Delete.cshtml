@model DocumentDeleteViewModel

@{
    ViewData["Title"] = "Delete Document";
}

<h1 class="h3 mb-3">Delete Document</h1>

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="alert alert-warning">
    Confirm that this document should be soft deleted. The row will remain in the database with DeletedAtUtc set.
</div>

<dl class="row">
    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Document Number</dt>
    <dd class="col-sm-9">@Model.DocumentNumber</dd>

    <dt class="col-sm-3">Department</dt>
    <dd class="col-sm-9">@Model.Department</dd>

    <dt class="col-sm-3">Owner</dt>
    <dd class="col-sm-9">@Model.OwnerName</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
