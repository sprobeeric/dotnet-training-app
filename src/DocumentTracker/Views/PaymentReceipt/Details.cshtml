@model PaymentReceiptDetailsViewModel

@{
    ViewData["Title"] = "Payment Receipt Details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Payment Receipt Details</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Payment Receipts</a>
</div>

<h2 class="h5 mt-4">Payment Summary</h2>

<dl class="row">
    <dt class="col-sm-3">Total Amount</dt>
    <dd class="col-sm-9">@Model.TotalAmount.ToString("N2")</dd>

    <dt class="col-sm-3">Received</dt>
    <dd class="col-sm-9">@Model.Received.ToString("N2")</dd>

    <dt class="col-sm-3">Change</dt>
    <dd class="col-sm-9">@Model.ChangeAmount.ToString("N2")</dd>
</dl>

<dl class="row">
    <dt class="col-sm-3">Receipt Number</dt>
    <dd class="col-sm-9">@Model.ReceiptNumber</dd>

    <dt class="col-sm-3">Payment Date</dt>
    <dd class="col-sm-9">@Model.PaymentDateUtc.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">Reference Number</dt>
    <dd class="col-sm-9">@Model.ReferenceNumber</dd>
</dl>

<h2 class="h5 mt-4">Purchased Products</h2>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Product</th>
            <th class="text-end">Unit Price</th>
            <th class="text-end">Quantity</th>
            <th class="text-end">Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Products)
        {
            <tr>
                <td>@product.ProductName</td>
                <td class="text-end">@product.UnitPrice.ToString("N2")</td>
                <td class="text-end">@product.Quantity</td>
                <td class="text-end">@product.LineTotal.ToString("N2")</td>
            </tr>
        }
    </tbody>
</table>
