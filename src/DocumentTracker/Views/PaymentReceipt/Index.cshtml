@model PaymentReceiptSearchViewModel

@{
    ViewData["Title"] = "Payment Receipts";
}

@functions {
    public string SortIcon(string column)
    {
        if (Model.Sort != column)
        {
            return "⇅";
        }

        return Model.Order == "asc" ? "↑" : "↓";
    }
}

<div class="d-flex flex-wrap justify-content-end align-items-end gap-2 mb-3">
    <a asp-action="Create" class="btn btn-primary">Create Payment Receipt</a>
</div>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-4 col-lg-3">
        <label asp-for="SearchTerm" class="form-label fw-bold">Search:</label>
        <input asp-for="SearchTerm" class="form-control" placeholder="Receipt or reference number" />
    </div>
    <div class="col-md-3 col-lg-2">
        <label asp-for="DateFrom" class="form-label fw-bold">Date Range:</label>
        <input asp-for="DateFrom"type="date" class="form-control" />
    </div>
    <div class="col-md-3 col-lg-2">
        <input asp-for="DateTo" type="date" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
    <div class="col-auto">
        <a asp-action="Index"class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (Model.PaymentReceipts.Count == 0)
{
    <div class="alert alert-info">No payment receipts were found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>
                        <a asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                           asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
                           asp-route-page="@Model.Page"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-sort="receipt_number"
                           asp-route-order="@(Model.Sort == "receipt_number" && Model.Order == "asc" ? "desc" : "asc")"
                           class="text-decoration-none text-dark">

                            Receipt Number
                            <span class="ms-1">@SortIcon("receipt_number")</span>
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                           asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
                           asp-route-page="@Model.Page"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-sort="reference_number"
                           asp-route-order="@(Model.Sort == "reference_number" && Model.Order == "asc" ? "desc" : "asc")"
                           class="text-decoration-none text-dark">

                            Reference Number
                            <span class="ms-1">@SortIcon("reference_number")</span>
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                           asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
                           asp-route-page="@Model.Page"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-sort="payment_date_utc"
                           asp-route-order="@(Model.Sort == "payment_date_utc" && Model.Order == "asc" ? "desc" : "asc")"
                           class="text-decoration-none text-dark">

                            Date
                            <span class="ms-1">@SortIcon("payment_date_utc")</span>
                        </a>
                    </th>
                    <th class="text-end">
                        <a asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                           asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
                           asp-route-page="@Model.Page"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-sort="total_amount"
                           asp-route-order="@(Model.Sort == "total_amount" && Model.Order == "asc" ? "desc" : "asc")"
                           class="text-decoration-none text-dark">

                            Total
                            <span class="ms-1">@SortIcon("total_amount")</span>
                        </a>
                    </th>
                    <th class="text-end">
                        <a asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                           asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
                           asp-route-page="@Model.Page"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-sort="received"
                           asp-route-order="@(Model.Sort == "received" && Model.Order == "asc" ? "desc" : "asc")"
                           class="text-decoration-none text-dark">

                            Received
                            <span class="ms-1">@SortIcon("received")</span>
                        </a>
                    </th>
                    <th class="text-end">
                        <a asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                           asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
                           asp-route-page="@Model.Page"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-sort="change_amount"
                           asp-route-order="@(Model.Sort == "change_amount" && Model.Order == "asc" ? "desc" : "asc")"
                           class="text-decoration-none text-dark">

                            Change
                            <span class="ms-1">@SortIcon("change_amount")</span>
                        </a>
                    </th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
            @foreach (var paymentReceipt in Model.PaymentReceipts)
            {
                <tr>
                    <td>@paymentReceipt.ReceiptNumber</td>
                    <td>@paymentReceipt.ReferenceNumber</td>
                    <td>@paymentReceipt.PaymentDateUtc.ToString("u")</td>
                    <td class="text-end">@paymentReceipt.TotalAmount.ToString("N2")</td>
                    <td class="text-end">@paymentReceipt.Received.ToString("N2")</td>
                    <td class="text-end">@paymentReceipt.ChangeAmount.ToString("N2")</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@paymentReceipt.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Delete" asp-route-id="@paymentReceipt.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-end">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                           asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
                           asp-route-sort="@Model.Sort"
                           asp-route-order="@Model.Order"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-pageSize="@Model.PageSize">
                            Previous
                        </a>
                    </li>

                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                               asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
                               asp-route-sort="@Model.Sort"
                               asp-route-order="@Model.Order"
                               asp-route-page="@i"
                               asp-route-pageSize="@Model.PageSize">
                                @i
                            </a>
                        </li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                           asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
                           asp-route-sort="@Model.Sort"
                           asp-route-order="@Model.Order"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-pageSize="@Model.PageSize">
                            Next
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}