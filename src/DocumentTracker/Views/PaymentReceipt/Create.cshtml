@model PaymentReceiptCreateViewModel

@{
    ViewData["Title"] = "Create Coffee Purchase";
}

<h1 class="h3 mb-3">Create Coffee Purchase</h1>
<p class="text-muted">Choose products and quantities, enter the amount received, and the receipt will be generated automatically.</p>

<form asp-action="Create" method="post" class="document-form purchase-form" data-purchase-form>
    @Html.AntiForgeryToken()
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <partial name="_PurchaseFormField" model="Model" />
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Generate Receipt</button>
        <a asp-controller="PaymentReceipts" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
