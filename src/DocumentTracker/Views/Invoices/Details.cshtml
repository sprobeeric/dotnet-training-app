@model InvoiceDetailsViewModel

@{
    ViewData["Title"] = "Invoice Details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Invoice Details</h1>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Id</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Invoice Number</dt>
    <dd class="col-sm-9">@Model.InvoiceNumber</dd>

    <dt class="col-sm-3">Customer</dt>
    <dd class="col-sm-9">@Model.CustomerName</dd>

    <dt class="col-sm-3">Invoice Date</dt>
    <dd class="col-sm-9">@Model.InvoiceDate.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">Due Date</dt>
    <dd class="col-sm-9">@Model.DueDate.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Subtotal</dt>
    <dd class="col-sm-9">@Model.Subtotal</dd>

    <dt class="col-sm-3">Tax Amount</dt>
    <dd class="col-sm-9">@Model.TaxAmount</dd>

    <dt class="col-sm-3">Total Amount</dt>
    <dd class="col-sm-9">@Model.TotalAmount</dd>

    <dt class="col-sm-3">Notes</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Notes) ? "None" : Model.Notes)</dd>

    <dt class="col-sm-3">Created At UTC</dt>
    <dd class="col-sm-9">@Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</dd>

    <dt class="col-sm-3">Updated At UTC</dt>
    <dd class="col-sm-9">@(Model.UpdatedAtUtc?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Not updated")</dd>

    <dt class="col-sm-3">Deleted At UTC</dt>
    <dd class="col-sm-9">@(Model.DeletedAtUtc?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Not deleted")</dd>
</dl>