@model InvoiceEditViewModel

@{
    ViewData["Title"] = "Edit Invoice";
}

<h1 class="h3 mb-3">Edit Invoice</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="document-form">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <partial name="_InvoiceEditFormFields" model="Model" />
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
