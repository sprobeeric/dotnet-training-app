@model PaymentReceiptDeleteViewModel

@{
    ViewData["Title"] = "Delete Payment Receipt";
}

<h1 class="h3 mb-3">Delete Payment Receipt</h1>

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="alert alert-warning">
    Confirm that this payment receipt should be soft deleted. The row will remain in the database with DeletedAtUtc set.
</div>

<dl class="row">
    <dt class="col-sm-3">Receipt Number</dt>
    <dd class="col-sm-9">@Model.ReceiptNumber</dd>

    <dt class="col-sm-3">Invoice Number</dt>
    <dd class="col-sm-9">@Model.InvoiceNumber</dd>

    <dt class="col-sm-3">Customer Name</dt>
    <dd class="col-sm-9">@Model.CustomerName</dd>

    <dt class="col-sm-3">Payment Date</dt>
    <dd class="col-sm-9">@Model.PaymentDate</dd>

    <dt class="col-sm-3">Amount Paid</dt>
    <dd class="col-sm-9">@Model.AmountPaid.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">Payment Method</dt>
    <dd class="col-sm-9">@Model.PaymentMethod</dd>

    <dt class="col-sm-3">Reference Number</dt>
    <dd class="col-sm-9">@Model.ReferenceNumber</dd>

    <dt class="col-sm-3">Notes</dt>
    <dd class="col-sm-9">@Model.Notes</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
