@model PaymentReceiptEditViewModel

@{
    ViewData["Title"] = "Edit Payment Receipt";
    var summary = Model.InvoiceSummary;
    var paymentDetailsEnabled = summary is not null;
    var availableBalance = summary is null ? 0m : summary.RemainingBalance + (summary.InvoiceId == Model.ExistingInvoiceId ? Model.AmountPaid ?? 0m : 0m);
    string[] paymentMethods = ["Cash", "Bank Transfer", "Check", "Credit Card", "Debit Card"];
}

<h1 class="h3 mb-3">Edit Payment Receipt</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="document-form" data-payment-receipt-create-form data-lookup-url="@Url.Action("Edit", "PaymentReceipts", new { id = Model.Id })">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="ExistingInvoiceId" type="hidden" />
    <input asp-for="InvoiceNumber" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3">1. Invoice Lookup</h2>
            <div class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label asp-for="InvoiceNumber" class="form-label"></label>
                    <input value="@Model.InvoiceNumber" class="form-control" placeholder="Enter an invoice number" disabled />
                    <span asp-validation-for="InvoiceNumber" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <button type="button" class="btn btn-outline-primary" data-invoice-lookup-button disabled>Lookup Invoice</button>
                </div>
            </div>
            <input asp-for="InvoiceId" type="hidden" />

            @if (!string.IsNullOrWhiteSpace(Model.InvoiceNumber) && !Model.HasInvoiceSummary)
            {
                <div class="alert alert-danger mt-3 mb-0">
                    No invoice matched <strong>@Model.InvoiceNumber</strong>.
                </div>
            }

            @if (summary is not null)
            {
                <div class="row g-3 mt-1">
                    <div class="col-lg-8">
                        <div class="border rounded p-3 h-100">
                            <h3 class="h6 mb-3">Invoice Details</h3>
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Invoice Number</dt>
                                <dd class="col-sm-8">@summary.InvoiceNumber</dd>
                                <dt class="col-sm-4">Customer</dt>
                                <dd class="col-sm-8">@summary.CustomerName</dd>
                                <dt class="col-sm-4">Invoice Date</dt>
                                <dd class="col-sm-8">@summary.InvoiceDate.ToString("yyyy-MM-dd")</dd>
                                <dt class="col-sm-4">Due Date</dt>
                                <dd class="col-sm-8">@summary.DueDate.ToString("yyyy-MM-dd")</dd>
                                <dt class="col-sm-4">Status</dt>
                                <dd class="col-sm-8"><span class="badge text-bg-secondary">@summary.Status</span></dd>
                                <dt class="col-sm-4">Notes</dt>
                                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(summary.Notes) ? "-" : summary.Notes)</dd>
                            </dl>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="border rounded p-3 h-100"
                             data-payment-summary
                             data-remaining-balance="@availableBalance">
                            <h3 class="h6 mb-3">Payment Summary</h3>
                            <dl class="row mb-0">
                                <dt class="col-7">Invoice Total</dt>
                                <dd class="col-5 text-end">@summary.InvoiceTotal.ToString("N2")</dd>
                                <dt class="col-7">Available Balance</dt>
                                <dd class="col-5 text-end fw-semibold">@availableBalance.ToString("N2")</dd>
                                <dt class="col-7">Updated Payment</dt>
                                <dd class="col-5 text-end" data-current-payment>@((Model.AmountPaid ?? 0m).ToString("N2"))</dd>
                                <dt class="col-7">Balance After Payment</dt>
                                <dd class="col-5 text-end" data-balance-after-payment>@(availableBalance - (Model.AmountPaid ?? 0m)).ToString("N2")</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3">2. Payment Details</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="ReceiptNumber" class="form-label"></label>
                    <input asp-for="ReceiptNumber" class="form-control" disabled="@(!paymentDetailsEnabled)" />
                    <span asp-validation-for="ReceiptNumber" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PaymentDate" class="form-label"></label>
                    <input asp-for="PaymentDate" type="date" class="form-control" disabled="@(!paymentDetailsEnabled)" />
                    <span asp-validation-for="PaymentDate" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PaymentMethod" class="form-label"></label>
                    <select asp-for="PaymentMethod" class="form-select" data-payment-method-input disabled="@(!paymentDetailsEnabled)">
                        <option value="">Select a payment method</option>
                        @foreach (var paymentMethod in paymentMethods)
                        {
                            <option value="@paymentMethod">@paymentMethod</option>
                        }
                    </select>
                    <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="AmountPaid" class="form-label"></label>
                    <input asp-for="AmountPaid" class="form-control" data-amount-paid-input disabled="@(!paymentDetailsEnabled)" />
                    <span asp-validation-for="AmountPaid" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ReferenceNumber" class="form-label"></label>
                    <input asp-for="ReferenceNumber" class="form-control" data-reference-number-input disabled="@(!paymentDetailsEnabled || string.Equals(Model.PaymentMethod, "Cash", StringComparison.Ordinal))" />
                    <span asp-validation-for="ReferenceNumber" class="text-danger"></span>
                </div>
                <div class="col-md-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="4" disabled="@(!paymentDetailsEnabled)"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary" disabled="@(!paymentDetailsEnabled)">Save</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
